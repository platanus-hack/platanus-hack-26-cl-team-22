!results/redes_validacion.json

# LLM record/replay logs: commit only the ones needed for the demo
llm-logs/*.jsonl
!llm-logs/demo.jsonl

# Secrets and local config
.env
.claude/settings.local.json

# Descargas originales: pesan cientos de MB, se regeneran con los scripts de datos/
data/raw/

