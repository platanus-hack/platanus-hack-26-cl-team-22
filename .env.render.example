# Guide to the environment variables to set in Render.
# This is NOT read by any code: copy each value into the Render dashboard
# (Environment tab of each service). Never commit real values.

# ───────────── Service "root-guia" (servidor-guia/, Node web service) ─────────────

# Required to call Claude. Secret: only on this service, never in the landing.
ANTHROPIC_API_KEY=sk-ant-...
# Origin(s) of the landing allowed by CORS (scheme + host, no trailing slash or path).
# Several: comma separated. Without it only localhost is allowed and the browser
# will block the calls.
ORIGENES=https://root-landing.onrender.com

# Already set in render.yaml (shown for reference):
# NODE_VERSION=24      # servidor-guia needs Node >= 23.6
# PORT                 # do not set: Render assigns it

# ───────────── Service "root-landing" (static site) ─────────────

# Public address of root-guia, full path. Optional: without them the person's case
# never leaves the page and the simulator uses its own explanation.
# Vite bakes them in at build time: after changing them, redeploy the site.
VITE_CASO_URL=https://root-guia.onrender.com/interpretar
VITE_GUIA_URL=https://root-guia.onrender.com/guia

# Already set in render.yaml (shown for reference):
# NODE_VERSION=22

# ───────────── Order ─────────────
# 1. Apply the Blueprint; Render asks for the sync:false values. Leave the VITE_* and
#    ORIGENES empty on the first pass if you don't know the addresses yet.
# 2. When both services exist, copy their real URLs (the .onrender.com address can carry
#    a suffix if the name was taken) into ORIGENES and the two VITE_* variables.
# 3. Redeploy root-landing so the VITE_* values reach the build.
# 4. Check https://<root-guia>/salud: it should answer { "ok": true, "clave": true }.
